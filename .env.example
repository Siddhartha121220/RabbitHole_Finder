DATABASE_URL=postgresql+psycopg://rabbit:rabbit@localhost:5432/rabbithole
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5   # trail faithfulness judge (rabbithole judge-trails)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
DATASET_MODE=dev
CLICKSTREAM_MONTHS=2026-07,2026-08,2026-09   # pin it: empty = "latest 3", which shifts when a new month is published
MLFLOW_TRACKING_URI=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:3000   # CORS: the only origin allowed to call the API
WIKI_USER_AGENT=RabbitHoleFinder/0.1 (student project; https://github.com/Siddhartha121220/RabbitHole_Finder)
RECOMMENDER=v1               # v1 heuristic | v2 LightGBM (run `rabbithole train-ltr` first)
